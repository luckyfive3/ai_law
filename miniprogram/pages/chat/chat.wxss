.chat-page { height:100vh; background:#f0f2f5; overflow:hidden; position:relative; }
.module-bar { position:fixed; top:0; left:0; right:0; z-index:100; padding:16rpx 20rpx 12rpx; background:#fff; display:flex; align-items:center; border-bottom:1rpx solid #f0f0f0; }
.module-scroll { white-space:nowrap; flex:1; }
.nav-icon-btn { width:72rpx; height:72rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.nav-icon-text { font-size:40rpx; color:#333; }
.module-tag { display:inline-flex; align-items:center; padding:8rpx 22rpx; font-size:24rpx; color:#666; background:#f5f5f5; border-radius:100rpx; margin-right:12rpx; }
.module-tag.active { background:#d4a574; color:#fff; font-weight:600; }

.message-list { position:absolute; left:0; right:0; padding:20rpx 24rpx; box-sizing:border-box; }

.welcome-section { display:flex; flex-direction:column; align-items:center; padding:60rpx 20rpx 40rpx; }
.welcome-icon { font-size:100rpx; margin-bottom:24rpx; }
.welcome-title { font-size:38rpx; font-weight:700; color:#1a1a2e; margin-bottom:12rpx; }
.welcome-desc { font-size:28rpx; color:#999; text-align:center; line-height:1.6; margin-bottom:36rpx; }
.welcome-questions { display:flex; flex-wrap:wrap; justify-content:center; gap:16rpx; }
.welcome-q-btn { padding:14rpx 28rpx; background:#fff; border:2rpx solid #d4a574; border-radius:100rpx; font-size:26rpx; color:#d4a574; }

.msg-row { display:flex; margin-bottom:32rpx; }
.msg-user { flex-direction:row-reverse; }
.msg-avatar { width:72rpx; height:72rpx; border-radius:50%; flex-shrink:0; overflow:hidden; }
.msg-avatar-user { margin-left:16rpx; background:#e8e8e8; display:flex; align-items:center; justify-content:center; font-size:32rpx; }
.msg-avatar-ai { margin-right:16rpx; display:flex; align-items:center; justify-content:center; font-size:36rpx; background:#16213e; }
.msg-bubble-wrap { max-width:calc(100% - 120rpx); }
.msg-bubble { padding:20rpx 28rpx; border-radius:20rpx; font-size:30rpx; line-height:1.7; word-break:break-all; }
.msg-bubble-user { background:linear-gradient(135deg,#1a1a2e,#16213e); color:#fff; border-top-right-radius:6rpx; }
.msg-bubble-ai { background:#fff; color:#333; border-top-left-radius:6rpx; box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05); }

.typing-indicator { color:#999; font-size:26rpx; }
.typing-cursor { color:#d4a574; font-weight:700; }

.law-refs { margin-top:16rpx; background:#fffdf6; border-left:6rpx solid #d4a574; border-radius:8rpx; padding:20rpx 24rpx; }
.law-refs-title { font-size:26rpx; color:#d4a574; font-weight:600; margin-bottom:12rpx; }
.law-ref-item { margin-bottom:12rpx; padding-bottom:12rpx; border-bottom:1rpx solid rgba(212,165,116,0.2); }
.law-ref-item:last-child { margin-bottom:0; padding-bottom:0; border-bottom:none; }
.law-ref-name { display:block; font-size:26rpx; color:#1a1a2e; font-weight:600; margin-bottom:6rpx; }
.law-ref-text { display:block; font-size:24rpx; color:#666; line-height:1.6; }

.input-area { position:fixed; bottom:0; left:0; right:0; z-index:100; background:#fff; padding:16rpx 24rpx; border-top:1rpx solid #f0f0f0; }
.input-wrapper { display:flex; align-items:flex-end; background:#f5f5f5; border-radius:40rpx; padding:8rpx 8rpx 8rpx 28rpx; border:2rpx solid transparent; }
.input-wrapper:focus-within { border-color:#d4a574; }
.chat-input { flex:1; font-size:30rpx; line-height:1.5; max-height:200rpx; min-height:40rpx; padding:10rpx 0; }
.send-btn { width:64rpx; height:64rpx; border-radius:50%; background:#e0e0e0; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-left:12rpx; }
.send-btn.active { background:linear-gradient(135deg,#d4a574,#e8c9a0); }
.send-text { font-size:32rpx; color:#fff; font-weight:700; }

.sidebar-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:200; opacity:0; pointer-events:none; }
.sidebar-mask.visible { opacity:1; pointer-events:auto; }
.chat-sidebar { position:fixed; top:0; left:0; bottom:0; width:560rpx; background:#fff; z-index:201; display:flex; flex-direction:column; transform:translateX(-100%); }
.chat-sidebar.visible { transform:translateX(0); }
.sidebar-header { padding:32rpx 28rpx 20rpx; border-bottom:1rpx solid #f0f0f0; display:flex; align-items:center; justify-content:space-between; }
.sidebar-title { font-size:32rpx; font-weight:700; color:#1a1a2e; }
.sidebar-new-btn { font-size:26rpx; color:#d4a574; padding:8rpx 20rpx; border:2rpx solid #d4a574; border-radius:100rpx; }
.sidebar-item { padding:24rpx 28rpx; border-bottom:1rpx solid #f8f8f8; }
.sidebar-item.active { background:rgba(212,165,116,0.08); border-left:6rpx solid #d4a574; }
.sidebar-item-title { font-size:28rpx; color:#333; margin-bottom:8rpx; }
.sidebar-item-time { font-size:22rpx; color:#bbb; }
.sidebar-empty { display:flex; align-items:center; justify-content:center; padding:80rpx; color:#ccc; font-size:26rpx; }
.load-more { display:flex; align-items:center; justify-content:center; padding:28rpx; color:#bbb; font-size:24rpx; }
