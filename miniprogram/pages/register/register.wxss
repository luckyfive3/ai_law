.page { min-height:100vh; background:linear-gradient(180deg, #1a1a2e 0%, #16213e 60%, #f5f5f5 60%); }
.header { display:flex; flex-direction:column; align-items:center; padding-bottom:60rpx; }
.logo { font-size:100rpx; margin-bottom:20rpx; }
.brand { font-size:44rpx; font-weight:700; color:#fff; margin-bottom:12rpx; }
.slogan { font-size:28rpx; color:rgba(255,255,255,0.6); }

.form { margin:0 48rpx; background:#fff; border-radius:24rpx; padding:48rpx 40rpx 40rpx; box-shadow:0 8rpx 40rpx rgba(0,0,0,0.12); }
.form-row { margin-bottom:36rpx; }
.label { font-size:28rpx; font-weight:600; color:#333; margin-bottom:12rpx; }
.input { height:88rpx; background:#f8f8f8; border-radius:16rpx; padding:0 24rpx; font-size:30rpx; line-height:88rpx; }

.agreement { display:flex; align-items:center; margin-bottom:40rpx; padding:4rpx 0; }
.cb { width:40rpx; height:40rpx; border:2rpx solid #d4a574; border-radius:6rpx; margin-right:12rpx; display:flex; align-items:center; justify-content:center; font-size:24rpx; color:#fff; flex-shrink:0; }
.cb.on { background:#d4a574; }
.agr-text { font-size:26rpx; color:#999; }

.btn { width:100%; height:96rpx; background:linear-gradient(135deg, #d4a574, #e8c9a0); color:#fff; font-size:34rpx; font-weight:600; border-radius:100rpx; display:flex; align-items:center; justify-content:center; margin-bottom:28rpx; }
.btn:active { opacity:0.85; }
.btn-loading { opacity:0.7; }

.foot { text-align:center; }
.link { font-size:28rpx; color:#d4a574; display:inline-block; padding:10rpx 0; }
