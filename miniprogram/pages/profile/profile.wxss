.page { min-height:100vh; background:#f5f5f5; }
.header { background:linear-gradient(135deg, #1a1a2e, #16213e); padding-bottom:40rpx; display:flex; flex-direction:column; align-items:center; }
.user-area { display:flex; flex-direction:column; align-items:center; }
.avatar { width:120rpx; height:120rpx; border-radius:50%; background:rgba(255,255,255,0.15); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:16rpx; }
.avatar image { width:100%; height:100%; }
.avatar-text { font-size:56rpx; }
.user-name { font-size:36rpx; font-weight:600; color:#fff; }
.login-hint { font-size:32rpx; color:rgba(255,255,255,0.6); }

.menu-section { background:#fff; margin:20rpx 28rpx; border-radius:16rpx; overflow:hidden; }
.menu-title { font-size:24rpx; color:#bbb; padding:20rpx 28rpx 8rpx; }
.menu-item { display:flex; align-items:center; justify-content:space-between; padding:28rpx; border-bottom:1rpx solid #f5f5f5; font-size:30rpx; color:#333; }
.menu-item:last-child { border-bottom:none; }
.arrow { color:#ccc; }

.logout-area { padding:40rpx 28rpx; }
.logout-btn { width:100%; height:88rpx; background:#fff; border:2rpx solid #ff4d4f; color:#ff4d4f; font-size:30rpx; border-radius:100rpx; display:flex; align-items:center; justify-content:center; }
