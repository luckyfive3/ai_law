# ═══════════════════════════════════════════════════════
# AI法律助手 v2.0 — 统一环境变量模板（前后端共用）
# 复制此文件为 .env 并填写实际值
# ═══════════════════════════════════════════════════════

# ====== MongoDB ======
MONGO_URI=mongodb://localhost:27017

# ====== JWT 鉴权 ======
JWT_SECRET=请修改为随机字符串至少32位

# ====== 后端服务地址（前端代理用） ======
BACKEND_URL=http://localhost:8080

# ====== 大模型 API（DeepSeek） ======
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ====== RAGFlow 知识库引擎 ======
RAGFLOW_API_KEY=请填写RAGFlow的API密钥
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_DATASET_ID=请填写RAGFlow的知识库数据集ID

# ====== 域名（生产环境 Nginx + SSL 用） ======
DOMAIN=your-domain.com
