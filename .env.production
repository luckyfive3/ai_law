# ─────────────────────────────────────────
# AI法律助手 v1.0 — 生产环境配置
# 复制此文件为 .env 并填写实际值
# ─────────────────────────────────────────

# ====== 数据库 ======
DB_USER=ailaw
DB_PASSWORD=请修改为强密码至少16位

# ====== Redis ======
REDIS_PASSWORD=请修改为强密码至少16位

# ====== JWT ======
JWT_SECRET=请修改为随机字符串至少32位

# ====== 大模型 API（DeepSeek） ======
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ====== 域名（用于 Nginx + Let's Encrypt） ======
DOMAIN=your-domain.com
