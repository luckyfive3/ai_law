# ─────────────────────────────────────────
# AI法律助手 v2.0 — 生产环境配置
# 技术栈: Python FastAPI + MongoDB + RAGFlow + LangChain
# 复制此文件为 .env 并填写实际值
# ─────────────────────────────────────────

# ====== MongoDB ======
MONGO_URI=mongodb://mongodb:27017

# ====== JWT ======
JWT_SECRET=请修改为随机字符串至少32位

# ====== 大模型 API（DeepSeek） ======
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ====== RAGFlow 知识库引擎 ======
RAGFLOW_API_KEY=请填写RAGFlow的API密钥
RAGFLOW_DATASET_ID=请填写RAGFlow的知识库数据集ID

# ====== 域名（用于 Nginx + Let's Encrypt） ======
DOMAIN=your-domain.com
